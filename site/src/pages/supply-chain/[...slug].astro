  .editorial-card-list {
    display: grid;
    gap: 12px;
  }

  .editorial-card,
  .timeline-list li,
  .attack-chain-list li {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 4px;
    padding: 16px;
  }

